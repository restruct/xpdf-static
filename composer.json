{
  "name": "restruct/xpdf-static",
  "description": "Pre-compiled xpdf tools with PHP wrappers (pdftotext, pdfinfo, pdftopng, pdfimages) for Linux x64 and macOS",
  "license": "(MIT AND (GPL-2.0-only OR GPL-3.0-only))",
  "authors": [
    {
      "name": "Restruct web & apps",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "symfony/process": "^6.0 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\Xpdf\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\Xpdf\\Tests\\": "tests/"
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ],
  "scripts": {
    "test": "phpunit"
  }
}
