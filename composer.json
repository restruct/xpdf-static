{
  "name": "restruct/xpdf-static",
  "description": "Pre-compiled Xpdf command-line tools (pdftotext, pdfinfo, pdftopng, pdfimages and more) for Linux and macOS, with fluent PHP wrappers",
  "keywords": ["php", "pdf", "xpdf", "pdftotext", "pdfinfo", "pdftopng", "pdfimages", "pdf-to-text", "static-binaries"],
  "license": "(MIT AND (GPL-2.0-only OR GPL-3.0-only))",
  "authors": [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "symfony/process": "^6.0 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\Xpdf\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\Xpdf\\Tests\\": "tests/"
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ],
  "scripts": {
    "test": "phpunit"
  }
}
